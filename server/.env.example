# ------------- Server -------------
PORT=5000
# Frontend URL(s) allowed to call the API (comma separated) or * for any
CORS_ORIGIN=*
# Where db.json is stored (leave empty for server/data)
DATA_DIR=
MAX_UPLOAD_MB=8

# ------------- Auth -------------
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRES=7d
# First admin account (created on first start)
ADMIN_EMAIL=admin@euphoria.com
ADMIN_PASSWORD=admin123

# ------------- Cloudinary (image uploads) -------------
# Leave empty to save uploads on the server disk instead
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------- Razorpay (payments) -------------
# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR

# ------------- Coupon -------------
COUPON_CODE=ROYAL15
COUPON_PERCENT=20
